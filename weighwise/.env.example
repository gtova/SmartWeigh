# Copy to server/.env (git-ignored). Never commit real keys.
DATABASE_URL=postgresql://weighwise:weighwise@localhost:5432/weighwise
REDIS_URL=
JWT_SECRET=change-me-in-env
WEB_ORIGIN=http://localhost:5173
PORT=4000

# AI agent: mock | gemini | claude
LLM_PROVIDER=mock
LLM_MODEL=models/gemini-3.5-flash
GEMINI_API_KEY=
GEMINI_THINKING_LEVEL=medium
# 1 = Google Search grounding (has its own quota), 0 = off
GEMINI_GOOGLE_SEARCH=1
LLM_MAX_TOKENS=65536
LLM_TIMEOUT_MS=90000
ANTHROPIC_API_KEY=

# Corporate proxy with TLS inspection: PEM with the proxy CA (added to Node's roots, verification stays on)
EXTRA_CA_FILE=

# Local development only: show the one-time code on the login screen
DEV_SHOW_OTP=0
